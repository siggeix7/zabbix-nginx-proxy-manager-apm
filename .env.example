# Directory ASSOLUTA che contiene i file proxy-host-*_access.log di NPM.
# Deve esistere sul sistema che esegue docker compose.
NPM_LOG_DIR=/path/to/nginx-proxy-manager/data/logs

# Zabbix Proxy 8 APM, listener OTLP/gRPC (non Zabbix Server).
ZABBIX_OTLP_ENDPOINT=zabbix-apm-proxy.example.invalid:4317

# Deve corrispondere ESATTAMENTE al campo Host name (tecnico) in Zabbix.
OTEL_HOST_NAME=proxy-manager-01
OTEL_ENVIRONMENT=production

# Default non privilegiato; usare 0/0 solo se le ACL dei log lo rendono necessario.
OTEL_COLLECTOR_UID=10001
OTEL_COLLECTOR_GID=10001
